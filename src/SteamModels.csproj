<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>10.0.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageTags>steam, dotnetcore, models, csgo, cs2, dota2, dota 2, steam user, steam group, steam user stats, match details</PackageTags>
    <PackageReleaseNotes>Targets .NET 10. Adds Dota 2 models covering match history, match details, heroes, in game items, rarities, leagues, live league games, top live games and team info. Adds the player summary fields the Steam API returns today, profile in game info and web links, and the error payload returned for private profiles. Hardens the CS:GO derived stats against private profiles and zero denominators.</PackageReleaseNotes>
    <Description>.NET models for Steam API entities, with game specific models for Counter-Strike and Dota 2.</Description>
    <Authors>kdinev</Authors>
    <Copyright>2019-2026 Bellum Gens</Copyright>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageProjectUrl>https://bellumgens.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BellumGens/SteamModels</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <Company>Bellum Gens</Company>
    <PackageIcon>avatar_BG_blood.png</PackageIcon>
    <PackageIconUrl />
    <PackageId>SteamModels</PackageId>
    <Product>SteamModels</Product>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>Steam Models</Title>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="Assets\avatar_BG_blood.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
